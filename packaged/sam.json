{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Outputs": {},
  "Resources": {
    "Index": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Runtime": "python3.12",
        "Handler": "app.index",
        "CodeUri": "./deployment.zip",
        "Tags": {
          "aws-chalice": "version=1.31.0:stage=dev:app=techops-onboard-bitwarden"
        },
        "Tracing": "PassThrough",
        "Timeout": 60,
        "MemorySize": 128,
        "Role": "arn:aws:iam::588146318465:role/TechOps-lambda-role"
      }
    }
  }
}
